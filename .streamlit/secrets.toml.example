# .streamlit/secrets.toml.example
# For Streamlit Community Cloud (share.streamlit.io), add these under App Settings -> Secrets.

# Anthropic Claude API Configuration
ANTHROPIC_API_KEY = "sk-ant-api03-your-key-here"
CLAUDE_MODEL = "claude-3-5-haiku-20241022"
LLM_PROVIDER = "claude"

# Cloud Embedding and Vector Store Configuration
EMBEDDING_PROVIDER = "cloud"
VECTOR_STORE_PROVIDER = "chroma"

# Optional Cloud Vector Database (Qdrant Cloud Free Tier)
# QDRANT_URL = "https://your-cluster-id.qdrant.tech:6333"
# QDRANT_API_KEY = "your-qdrant-api-key"

