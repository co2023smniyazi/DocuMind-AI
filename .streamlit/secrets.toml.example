# .streamlit/secrets.toml.example
# For Streamlit Community Cloud (share.streamlit.io), paste these into:
# App Settings -> Secrets (in TOML format).
# NEVER commit your real secrets.toml or active API keys to git.

# -----------------------------------------------------------------------------
# 1. Primary Cloud LLM: Google Gemini API (Free Tier: 15 RPM, 1M TPM, 1,500 RPD)
# Get a free key (Rs 0, no credit card required) at: https://aistudio.google.com/apikey
# -----------------------------------------------------------------------------
LLM_PROVIDER = "gemini"
GEMINI_API_KEY = "AIzaSyYourRealGeminiKeyHere"
GEMINI_MODEL = "gemini-2.0-flash"

# -----------------------------------------------------------------------------
# 2. Persistent Cloud Vector Database: Qdrant Cloud Free Tier (1 GB cluster)
# Console: https://cloud.qdrant.io/
# Use your cluster endpoint (do NOT add port :6333 unless using gRPC)
# -----------------------------------------------------------------------------
VECTOR_STORE_PROVIDER = "qdrant"
# Also accepted as alias: VECTOR_PROVIDER = "qdrant"
QDRANT_URL = "https://bc55f8d5-f950-414a-9251-97c65f673774.us-east-1-1.aws.cloud.qdrant.io"
QDRANT_API_KEY = "your-replacement-qdrant-api-key-here"
QDRANT_COLLECTION = "college_documents"

# -----------------------------------------------------------------------------
# 3. Embedding Engine: FastEmbed ONNX (In-process, zero API key)
# BAAI/bge-small-en-v1.5 (384 dimensions, ~67MB weights, ~145MB process RAM)
# -----------------------------------------------------------------------------
EMBEDDING_PROVIDER = "fastembed"
# Also accepted as alias: EMBED_PROVIDER = "fastembed"

# -----------------------------------------------------------------------------
# 4. Optional LLM Integrations (Strictly OFF by default to enforce Rs 0 budget)
# -----------------------------------------------------------------------------
ENABLE_CLAUDE = "false"

# Optional Secondary Free LLM: Groq Cloud (Free Tier: 30 RPM, 12k TPM)
# GROQ_API_KEY = "gsk_YourGroqApiKeyHere"
# GROQ_MODEL = "llama-3.3-70b-versatile"
