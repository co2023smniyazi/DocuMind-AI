# .streamlit/secrets.toml.example
# For Streamlit Community Cloud (share.streamlit.io), add these keys under:
# App Settings -> Secrets (paste contents in TOML format).
# NEVER commit your real secrets.toml with sensitive keys to git.

# -------------------------------------------------------------
# 1. Primary Free Cloud LLM: Google Gemini (Recommended Default)
# Free Tier: 15 RPM, 1M TPM, 1,500 RPD (Zero INR / Zero USD)
# Get free API key: https://aistudio.google.com/
# -------------------------------------------------------------
LLM_PROVIDER = "gemini"
GEMINI_API_KEY = "AIzaSyYourGeminiApiKeyHere"
GEMINI_MODEL = "gemini-2.0-flash"

# -------------------------------------------------------------
# 2. Secondary Free Cloud LLM: Groq Cloud (Optional)
# Free Tier: 30 RPM, 6k-30k TPM (Fast LPU inference)
# Get free API key: https://console.groq.com/
# -------------------------------------------------------------
# GROQ_API_KEY = "gsk_YourGroqApiKeyHere"
# GROQ_MODEL = "llama-3.3-70b-versatile"

# -------------------------------------------------------------
# 3. Vector Database: Qdrant Cloud Free Tier (Optional)
# Free Tier: 1 GB Managed Cluster (Zero INR / Zero USD)
# Get free cluster: https://cloud.qdrant.io/
# Note: Suspends after 7 days inactivity; wake in Qdrant console.
# If unset, DocuMind AI falls back to ChromaDB / in-memory vector store.
# -------------------------------------------------------------
# VECTOR_STORE_PROVIDER = "qdrant"
# QDRANT_URL = "https://your-cluster-id.region.gcp.cloud.qdrant.io:6333"
# QDRANT_API_KEY = "your-qdrant-api-key"

# -------------------------------------------------------------
# 4. Embeddings: FastEmbed ONNX (In-Container)
# Uses BAAI/bge-small-en-v1.5 (384 dimensions, zero API cost)
# -------------------------------------------------------------
EMBEDDING_PROVIDER = "fastembed"

# -------------------------------------------------------------
# 5. Anthropic Claude (Optional / Paid API — OFF by default)
# Budget Rule: Kept false by default. Requires paid credits.
# -------------------------------------------------------------
ENABLE_CLAUDE = "false"
# ANTHROPIC_API_KEY = "sk-ant-api03-your-key-here"
# CLAUDE_MODEL = "claude-3-5-haiku-20241022"
